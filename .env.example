# Nuxt server routes (local dev). On Cloudflare, a Hyperdrive binding named HYPERDRIVE is used instead.
NUXT_DATABASE_URL=postgres://user:password@host:5432/baller_knowledge

# Ingest job (ingest/)
DATABASE_URL=postgres://user:password@host:5432/baller_knowledge
# stats.nba.com blocks many cloud IPs. An HTTP(S) proxy URL that it accepts.
NBA_API_PROXY=
# Fallback for games and scores: https://www.balldontlie.io (free tier key)
BALLDONTLIE_API_KEY=
